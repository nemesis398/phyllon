# Copy to .env and adjust. compose.yaml reads it from the same directory.

# Starts Caddy in front of Phyllon. Remove proxy here when another proxy on
# the host reaches Phyllon instead.
COMPOSE_PROFILES=proxy
# The public name. Caddy gets a certificate for it on its own; for localhost
# it uses its internal CA, which a browser warns about.
PHYLLON_DOMAIN=localhost
# The published ports. 80 and 443 for a public name; rootless Podman needs
# net.ipv4.ip_unprivileged_port_start=80 for those (see docs/install.md).
HTTP_PORT=8080
HTTPS_PORT=8443
PHYLLON_IMAGE=ghcr.io/nemesis398/phyllon:0.1
