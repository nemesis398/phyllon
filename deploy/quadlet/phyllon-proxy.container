# Caddy in front of Phyllon, for rootless Podman under systemd. A host with its
# own proxy leaves this unit out. The hardening matches compose.yaml.

[Unit]
Description=Caddy in front of Phyllon
# Like compose's depends_on, this orders the start only: starting the proxy
# starts Phyllon, and waits until it is healthy. Requires= would also stop or
# restart Caddy whenever Phyllon is stopped or restarted, which podman
# auto-update does on each new image.
Wants=phyllon.service
After=phyllon.service

[Container]
ContainerName=phyllon-proxy
Image=docker.io/library/caddy:2.11.7@sha256:5e5286cb37d44086d651a5363f05f43a692ce4d649d88fb1bd844579f45fa9e8
# Caddy's own uid, so it shares no files with Phyllon (65532).
User=65533
Group=65533
ReadOnly=true
Tmpfs=/config/caddy
DropCapability=ALL
# The caddy binary carries the file capability cap_net_bind_service, and the
# kernel refuses to run it when the capability is missing from the bounding
# set (see compose.yaml).
AddCapability=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Memory=256m
PidsLimit=128
# The public name and port. Change them along with public_url in
# phyllon.toml. Ports 80 and 443 need net.ipv4.ip_unprivileged_port_start=80
# under rootless Podman (see docs/install.md).
Environment=PHYLLON_DOMAIN=localhost
Environment=HTTPS_PORT=8443
PublishPort=8080:8080
PublishPort=8443:8443
Volume=%h/.config/phyllon/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=phyllon-caddy.volume:/data/caddy
Network=phyllon-edge.network
HealthCmd=["wget", "-qO", "/dev/null", "http://127.0.0.1:2019/config/"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
# Until the first success the check runs every 2 s, like compose's
# start_interval, so a start does not wait a whole interval.
HealthStartupCmd=["wget", "-qO", "/dev/null", "http://127.0.0.1:2019/config/"]
HealthStartupInterval=2s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
